{
  "name": "desktop-friends",
  "productName": "Desktop Friends",
  "version": "0.1.0",
  "description": "A small desktop home for your friends and their avatars.",
  "main": ".vite/build/main.js",
  "scripts": {
    "start": "electron-forge start",
    "start:second": "node scripts/start-second.mjs",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "publish": "electron-forge publish",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "users:test": "node scripts/create-test-users.mjs",
    "sprites:pack": "electron scripts/pack-sprites.cjs"
  },
  "dependencies": {
    "koffi": "3.3.1",
    "pixi.js": "^8.9.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@electron-forge/plugin-vite": "^7.11.2",
    "@electron-forge/shared-types": "^7.11.2",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "electron": "^41.0.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "electron@41.10.7": true,
    "fsevents@2.3.3": true,
    "fs-xattr@0.3.1": true,
    "macos-alias@0.2.12": true,
    "koffi@3.3.1": false
  }
}
