# Where the app reaches the Desktop Friends backend: the nginx gateway in front of it, ending in /api.
# Locally that's http://localhost:8088/api (see docker-compose.dev.yml); for a server, its HTTPS address.
# The app holds no database or Supabase keys: those live only on the backend (backend/.env).
VITE_API_BASE_URL=http://localhost:8088/api
