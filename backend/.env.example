# Copy to backend/.env (never commit it). These are server-side secrets: they stay on the backend and are
# never shipped in the desktop app.

# Supabase → Project Settings → API (URL) and API Keys (publishable key).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Supabase → Connect → Session pooler. Turn its host and user into these three values:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.<ref>
SUPABASE_DB_PASSWORD=your-database-password

# Optional
# PORT=8080
# CORS_ALLOWED_ORIGINS=http://localhost:5173,file://,null
